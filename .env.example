SYNCTHING_URL=http://ssrb.local:8384
SYNCTHING_API_KEY=replace-me
NOTIFICATIONS_URL=http://kiosko.local:3000/api/notifications

STATE_FILE=/data/state.json
SYNC_DIRECTION=both
FOLDER_NAMES_JSON={"screenshots":"Capturas de pantalla","obsidian":"Obsidian","camera":"Fotos del móvil"}
LOG_LEVEL=info

EVENT_TIMEOUT_SECONDS=60
RECONNECT_MIN_DELAY_MS=1000
RECONNECT_MAX_DELAY_MS=30000
NOTIFICATION_TIMEOUT_MS=10000

# Merge consecutive folder completions caused by follow-up operations such as automatic moves.
DEDUPLICATION_WINDOW_SECONDS=60
