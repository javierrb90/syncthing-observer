# Syncthing hub
SYNCTHING_URL=http://ssrb.local:8384
SYNCTHING_API_KEY=replace-with-your-syncthing-api-key

# Pushover: create an application at https://pushover.net/apps
PUSHOVER_APP_TOKEN=replace-with-your-pushover-application-token
PUSHOVER_USER_KEY=replace-with-your-pushover-user-key

# Leave blank to send to every active device registered in the Pushover account.
PUSHOVER_DEVICE=

# Optional Pushover sound names. Blank uses the recipient's defaults.
PUSHOVER_SOUND=
PUSHOVER_ERROR_SOUND=

STATE_FILE=/data/state.json

# Optional overrides by Syncthing Folder ID. Normally the Syncthing label is used automatically.
FOLDER_NAMES_JSON={}
LOG_LEVEL=info

# A notification is sent after the folder has remained idle for this many seconds.
QUIET_PERIOD_SECONDS=10

EVENT_TIMEOUT_SECONDS=60
RECONNECT_MIN_DELAY_MS=1000
RECONNECT_MAX_DELAY_MS=30000

NOTIFICATION_TIMEOUT_MS=10000
NOTIFICATION_ATTEMPTS=5
NOTIFICATION_RETRY_DELAY_SECONDS=60
OUTBOX_RETRY_DELAY_SECONDS=300

# Local HTTP endpoint used for health checks and a protected Pushover test.
HTTP_HOST=0.0.0.0
HTTP_PORT=8787
TEST_API_TOKEN=replace-with-a-random-secret-of-at-least-16-characters
